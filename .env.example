# ============================
# Hospital Management System
# Environment Configuration
# ============================

# Server
PORT=4000
NODE_ENV=development

# Database Configuration (DB_TYPE=firestore or mysql)
DB_TYPE=firestore

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=hospital_mgmt

# Firebase Firestore Configuration
# (For local dev using Firestore Emulator, set FIRESTORE_EMULATOR_HOST=localhost:8080)
# FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_PROJECT_ID=hospital-mgmt-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@hospital-mgmt-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
# FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=24h

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@hospitalms.com

# ML Service
ML_SERVICE_URL=http://localhost:5001

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
